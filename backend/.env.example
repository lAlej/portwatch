# --- Server ---
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# --- Auth (generate hash with: pnpm hash-password) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_TTL_SECONDS=86400

# --- Cookies ---
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- Network / abuse protection ---
# Browser origins allowed to call the API cross-origin and open WebSockets,
# comma-separated. Leave empty when the UI and API share an origin (Caddy).
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the backend (Caddy = 1, direct access = 0).
# Wrong values let clients spoof their IP and dodge the login rate limit.
TRUST_PROXY_HOPS=0
# Failed logins allowed per IP per window before getting HTTP 429.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Docker ---
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Realtime ---
STATS_INTERVAL_MS=1000
LOG_BUFFER=2000
