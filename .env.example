# --- Server ---
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# --- Auth (generate hash: cd backend && pnpm hash-password my-secret) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- JWT (32+ chars) ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_TTL_SECONDS=86400

# --- Cookies ---
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- Docker ---
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Realtime ---
STATS_INTERVAL_MS=1000
LOG_BUFFER=2000
